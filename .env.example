# ── Postgres (Neon via @vercel/postgres) ─────────────────────────────
# @vercel/postgres reads POSTGRES_URL. For local dev point it at any Postgres.
POSTGRES_URL="postgres://user:pass@localhost:5432/mindprint"
# @vercel/postgres also honors these if present (Neon sets them automatically):
# POSTGRES_URL_NON_POOLING=
# POSTGRES_PRISMA_URL=

# ── Airtable item-bank CMS (read-only from app) ──────────────────────
AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""
# Comma-separated table names to sync into item_cache
AIRTABLE_TABLES="items"

# ── Analytics ────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=""
PIPEDREAM_WEBHOOK_URL=""

# ── Admin / ops protected routes ─────────────────────────────────────
# Bearer token required by /api/admin/*, /api/seed-answers, /api/cron/*
ADMIN_TOKEN=""
CRON_SECRET=""

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── Consent copy versions (bump when copy changes; see src/lib/consent.ts) ──
# These are code constants, not env — listed here only as a reminder.
